# Copy to `.env` in the project root and fill in values:
#   cp .env.example .env
#
# Then sync native iOS config (Android reads `.env` at Gradle build time):
#   dart run tool/sync_env.dart
#
# Never commit `.env` — it is gitignored.

# API base URL (no trailing slash)
API_BASE_URL=https://goodscarrier.ajonetech.com

# Set to false to use local dummy repositories without network
USE_REMOTE_API=true

# Google Maps (Android/iOS) + Places autocomplete (Dart)
#
# In Google Cloud Console, enable ALL of these on the same project/key:
#   • Places API          — address autocomplete (REST)
#   • Maps SDK for iOS    — native map tiles (bundle: com.goodscarrier.goodsCarrier)
#   • Maps SDK for Android — native map tiles (package: com.goodscarrier.goods_carrier)
# Billing must be enabled. Then run: dart run tool/sync_env.dart
GOOGLE_API_KEY=

# Razorpay — driver subscription checkout.
#
# Publishable key IDs only. The Key Secret must NEVER appear here: this file is
# bundled as a Flutter asset and is extractable from a shipped APK/IPA. The
# secret belongs in backend env, where it signs the order and verifies the
# payment signature.
#
# RAZORPAY_MODE must match the mode the backend creates orders in — a live key
# cannot pay a test order. These keys are only a fallback for when the initiate
# response omits `razorpay_key`.
RAZORPAY_MODE=test
RAZORPAY_KEY_TEST=
RAZORPAY_KEY_LIVE=

# Full iOS App Store URL for update prompts (leave empty until published)
IOS_APP_STORE_URL=
